// bq25895 — TI's BQ25895 I2C-controlled single-cell 5 A fast charger with
// MaxCharge, on its I2C bus, as the charger side of devices-nv's
// `PowerManager` and as `Identifiable`.
//
// A charger takes power from a USB or an adapter input, supplies the
// system and charges a lithium cell in phases: a low precharge current
// while the cell is deeply discharged, a constant fast-charge current,
// then a constant voltage until the current falls to the termination
// current.  The part also has a battery monitor (an ADC), a boost mode that
// powers the input pin from the cell (OTG) and a watchdog.  The facts below
// are from TI's data sheet "BQ25895 I2C Controlled Single Cell 5-A Fast
// Charger with MaxCharge for High Input Voltage and Adjustable Voltage
// 3.1-A Boost Operation", SLUSC88C, March 2015, revised October 2022; the
// sections and tables named are that sheet's.  Zephyr has no driver for
// this part (its chargers are the BQ24190, BQ2429x, BQ2518x and BQ25713).
//
// The bus (section 8.2.16.6 and 8.2.16.7).  The 7-bit address is 0x6A.  A
// read is the register, a repeated start and the data; "the charger device
// supports multi-read and multi-write on REG00 through REG14 except REG0C",
// and the register address advances.  Fix kept: the `bq25895` crate
// (DanNixon/bq25895) fixed its register writes to a single I2C transaction
// in its 0.0.4; every write here is the register and the byte in one.
//
// The registers this driver uses (Tables 8-8 to 8-28; REG08 and the
// thermal and pulse controls of REG01, REG09 and REG0A are not used):
//
//   REG00  EN_HIZ 7, EN_ILIM 6, IINLIM 5:0 (100 mA + 50 mA a step)
//   REG02  CONV_START 7, CONV_RATE 6, BOOST_FREQ 5, ICO_EN 4, HVDCP_EN 3,
//          MAXC_EN 2, FORCE_DPDM 1, AUTO_DPDM_EN 0
//   REG03  BAT_LOADEN 7, WD_RST 6, OTG_CONFIG 5, CHG_CONFIG 4,
//          SYS_MIN 3:1 (3.0 V + 0.1 V a step)
//   REG04  EN_PUMPX 7, ICHG 6:0 (64 mA a step, to 5056 mA)
//   REG05  IPRECHG 7:4 (64 mA + 64 mA a step), ITERM 3:0 (the same)
//   REG06  VREG 7:2 (3.840 V + 16 mV a step, to 4.608 V), BATLOWV 1,
//          VRECHG 0
//   REG07  EN_TERM 7, STAT_DIS 6, WATCHDOG 5:4, EN_TIMER 3, CHG_TIMER 2:1
//   REG09  FORCE_ICO 7, TMR2X_EN 6, BATFET_DIS 5, BATFET_DLY 3
//   REG0A  BOOSTV 7:4 (4.55 V + 64 mV a step)
//   REG0B  VBUS_STAT 7:5, CHRG_STAT 4:3, PG_STAT 2, SDP_STAT 1, VSYS_STAT 0
//   REG0C  WATCHDOG_FAULT 7, BOOST_FAULT 6, CHRG_FAULT 5:4, BAT_FAULT 3,
//          NTC_FAULT 2:0
//   REG0D  FORCE_VINDPM 7, VINDPM 6:0 (2.6 V + 0.1 V a step)
//   REG0E  THERM_STAT 7, BATV 6:0 (2.304 V + 20 mV a step)
//   REG0F  SYSV 6:0 (2.304 V + 20 mV a step)
//   REG10  TSPCT 6:0 (21 % + 0.465 % a step of REGN)
//   REG11  VBUS_GD 7, VBUSV 6:0 (2.6 V + 100 mV a step)
//   REG12  ICHGR 6:0 (50 mA a step)
//   REG13  VDPM_STAT 7, IDPM_STAT 6, IDPM_LIM 5:0 (100 mA + 50 mA a step)
//   REG14  REG_RST 7, ICO_OPTIMIZED 6, PN 5:3 (111 for the BQ25895),
//          TS_PROFILE 2, DEV_REV 1:0 (01)
//
// The watchdog (section 8.3.1).  After a power-on reset the part is in
// default mode with its watchdog expired, and charges on its register
// defaults.  Any write moves it to host mode, and in host mode the host
// "has to reset the watchdog timer by writing 1 to WD_RST ... before the
// watchdog timer expires (WATCHDOG_FAULT bit is set), or disable watchdog
// timer by setting WATCHDOG bits = 00".  An expired watchdog returns every
// register to its default except IINLIM, VINDPM, VINDPM_OS, BATFET_RST_EN,
// BATFET_DLY and BATFET_DIS.  The default is 40 s.  `start` disables the
// watchdog, so a program that does not feed it keeps its settings, and the
// safety timer still ends a charge; `watchdog_set` and `watchdog_feed` keep
// it on.
//
// The faults (REG0C, section 8.2.9.2).  The register keeps the faults since
// its last read and the next read answers the present state, so "to read
// the current fault status, the host has to read REG0C two times
// consecutively"; NTC_FAULT alone always reports the present state.
// `faults_read` reads twice and answers both.  REG0C does not support a
// multi-byte read, so it is read alone.
//
// The input current limit changes by itself.  IINLIM "bits are changed
// automatically after input source type detection is completed" (REG00),
// and the input current optimizer may lower it; the limit in effect is
// REG13's IDPM_LIM, which `input_current_effective` reads.  The limit is
// the lower of the register and the ILIM pin when EN_ILIM is set.
//
// The battery monitor (section 8.2.8).  A one-shot conversion is started
// with CONV_START (CONV_RATE = 0), the bit stays set during the conversion
// and the part clears it; "the conversion result is ready after tCONV
// (maximum 1 second)", typical 8 ms (the electrical table).  With CONV_RATE
// = 1 the part converts every second and CONV_START is read-only.  The
// ADC runs in battery-only mode only when V(BAT) is above SYS_MIN, and the
// charge current is measured in charge mode only (Table 8-6); ICHGR
// reads 0 for V(BAT) below V(BATSHORT).
//
// Drivers read for their fixes, nothing ported: the `bq25895` crate
// (DanNixon/bq25895, 0.0.5) and the register descriptions of the data
// sheet.  Each fix kept is named at its site.

use core.rt
use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut, AsyncEdge }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_power.{ MilliVolts, MilliAmps, RailState, ChargeState, BatteryReading, BatteryHealth, PowerSource, PowerManager, PowerManagerAsync }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let REG00 = 0x00
let REG02 = 0x02
let REG03 = 0x03
let REG04 = 0x04
let REG05 = 0x05
let REG06 = 0x06
let REG07 = 0x07
let REG09 = 0x09
let REG0A = 0x0A
let REG0B = 0x0B
let REG0C = 0x0C
let REG0D = 0x0D
let REG0E = 0x0E
let REG13 = 0x13
let REG14 = 0x14

// REG00's bits.
let EN_HIZ      = 0x80
let EN_ILIM     = 0x40
let IINLIM_MASK = 0x3F

// REG02's bits.
let CONV_START   = 0x80
let CONV_RATE    = 0x40
let BOOST_FREQ   = 0x20
let ICO_EN       = 0x10
let HVDCP_EN     = 0x08
let MAXC_EN      = 0x04
let AUTO_DPDM_EN = 0x01

// REG03's bits.
let WD_RST       = 0x40
let OTG_CONFIG   = 0x20
let CHG_CONFIG   = 0x10
let SYS_MIN_MASK = 0x0E

// REG04's current field.
let ICHG_MASK = 0x7F

// REG05's fields.
let IPRECHG_MASK = 0xF0
let ITERM_MASK   = 0x0F

// REG06's fields.
let VREG_MASK = 0xFC
let BATLOWV   = 0x02
let VRECHG    = 0x01

// REG07's bits.
let EN_TERM        = 0x80
let WATCHDOG_MASK  = 0x30
let EN_TIMER       = 0x08
let CHG_TIMER_MASK = 0x06

// REG09's bits.
let BATFET_DIS = 0x20
let BATFET_DLY = 0x08

// REG0A's boost voltage field.
let BOOSTV_MASK = 0xF0

// REG0D's bits.
let FORCE_VINDPM = 0x80
let VINDPM_MASK  = 0x7F

// REG14's bits.
let REG_RST = 0x80

// PN, the part number field of REG14, for the BQ25895.
let PN_BQ25895 = 7

// The most polls `reset` makes for REG_RST to clear.
let RESET_POLLS = 1000

// The most 10 ms pauses `adc_measure` and the host form wait for a
// conversion: 1 second, the data sheet's maximum, and a margin.
let ADC_POLLS   = 120
let ADC_POLL_MS = 10

// The bus clock `setup` asks for: fast mode, 400 kHz (the part allows
// 400 kHz).
let I2C_HZ = 400000

// The battery monitor's five readings, REG0E to REG12: the battery
// voltage, the system voltage and the VBUS voltage in millivolts, the
// thermistor as thousandths of a percent of REGN, and the charge current
// in milliamps; `vbus_good` is REG11's VBUS_GD.
pub @value
struct Bq25895Adc
    vbat_mv: Int
    vsys_mv: Int
    vbus_mv: Int
    ts_milli_pct: Int
    ichg_ma: Int
    vbus_good: Bool

// The fault register as the two reads give it: `past` the faults since the
// last read and `now` the present state.
pub @value
struct Bq25895Faults
    past: Int
    now: Int

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `pause_ms` waits; `irq_level` answers the level of the INT
// pin.
pub trait Bq25895Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn pause_ms(self, ms: Int) [hw]
    fn irq_level(self) -> Int [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction: whether
// the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Makes the bus ready: the INT pin an input with a pull-up (the pin is
// open-drain and pulses low for 256 us), the bus at 400 kHz.  Answers
// whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 2)
    bus.init(I2C_HZ)
    w.addr != None

// The level of the INT pin on the board, 1 or 0, or -1 for a wiring with
// no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Bq25895Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  Not for a register with a bit that clears itself
// (REG02's CONV_START, REG03's WD_RST, REG09's FORCE_ICO, REG14's
// REG_RST).
pub fn reg_write<P: Bq25895Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Reads `reg`, clears the bits of `mask`, sets `fl` (a subset of `mask`),
// writes it back and reads it again: whether the part holds the bits.
// Fix kept: every setting is a masked update, as the part keeps several
// settings in one register, and a write of one byte would undo the others.
pub fn reg_update<P: Bq25895Port>(p: P, reg: Int, mask: Int, fl: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    let next = (old & (0xFF ^ mask)) | (fl & mask)
    if not p.write_reg(reg, next)
        return false
    let Some(back) = reg_read(p, reg) else return false
    (back & mask) == (fl & mask)

// A masked update of a register that holds a self-clearing bit that the
// update must not write back as it reads: `keep_clear` bits are written as
// 0 whatever they read.  The read back compares the bits of `mask` only.
fn update_clearing<P: Bq25895Port>(p: P, reg: Int, mask: Int, fl: Int, keep_clear: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    let next = (old & (0xFF ^ keep_clear) & (0xFF ^ mask)) | (fl & mask)
    if not p.write_reg(reg, next)
        return false
    let Some(back) = reg_read(p, reg) else return false
    (back & mask) == (fl & mask)

// ── The steps of the fields ──────────────────────────────────────────

// The register code of a value on a linear scale: `base` plus `step` a
// code, held to 0 to `top`, rounded down; a value below `base` is code 0.
fn step_code(v: Int, base: Int, step: Int, top: Int) -> Int
    if v <= base
        return 0
    let c = (v - base) / step
    if c > top
        return top
    c

// The input current limit in milliamps for IINLIM or IDPM_LIM, 0 to 63:
// 100 mA and 50 mA a step, to 3250 mA.
//
// ```novo
// use bq25895
//
// fn main() [io]
//     println("${bq25895.ilim_ma(8)}")    // 500
//     println("${bq25895.ilim_ma(63)}")   // 3250
// ```
pub fn ilim_ma(code: Int) -> Int
    100 + (code & 0x3F) * 50

// The IINLIM code for a limit in milliamps, rounded down and held to 100
// to 3250 mA.
pub fn ilim_code(ma: Int) -> Int
    step_code(ma, 100, 50, 63)

// The fast charge current in milliamps for ICHG, 0 to 127: 64 mA a step.
// The part clamps a code above 79, 5056 mA, to it.
//
// ```novo
// use bq25895
//
// fn main() [io]
//     println("${bq25895.ichg_ma(32)}")   // 2048
//     println("${bq25895.ichg_ma(79)}")   // 5056
// ```
pub fn ichg_ma(code: Int) -> Int
    (code & 0x7F) * 64

// The ICHG code for a current in milliamps, rounded down and held to 0 to
// 5056 mA.  0 disables the charge.
pub fn ichg_code(ma: Int) -> Int
    if ma <= 0
        return 0
    step_code(ma, 0, 64, 79)

// The precharge current in milliamps for IPRECHG, 0 to 15: 64 mA and 64 mA
// a step, to 1024 mA.
pub fn ipre_ma(code: Int) -> Int
    64 + (code & 0x0F) * 64

// The IPRECHG code for a current in milliamps, rounded down and held to 64
// to 1024 mA.
pub fn ipre_code(ma: Int) -> Int
    step_code(ma, 64, 64, 15)

// The termination current in milliamps for ITERM, 0 to 15: 64 mA and 64 mA
// a step, to 1024 mA.
pub fn iterm_ma(code: Int) -> Int
    64 + (code & 0x0F) * 64

// The ITERM code for a current in milliamps, rounded down and held to 64
// to 1024 mA.
pub fn iterm_code(ma: Int) -> Int
    step_code(ma, 64, 64, 15)

// The charge voltage in millivolts for VREG, 0 to 63: 3840 mV and 16 mV a
// step.  The part clamps a code above 48, 4608 mV, to it.
//
// ```novo
// use bq25895
//
// fn main() [io]
//     println("${bq25895.vreg_mv(23)}")   // 4208
//     println("${bq25895.vreg_mv(48)}")   // 4608
// ```
pub fn vreg_mv(code: Int) -> Int
    3840 + (code & 0x3F) * 16

// The VREG code for a voltage in millivolts, rounded down and held to 3840
// to 4608 mV.
pub fn vreg_code(mv: Int) -> Int
    step_code(mv, 3840, 16, 48)

// The minimum system voltage in millivolts for SYS_MIN, 0 to 7: 3000 mV and
// 100 mV a step, to 3700 mV.
pub fn sysmin_mv(code: Int) -> Int
    3000 + (code & 0x07) * 100

// The SYS_MIN code for a voltage in millivolts, rounded down and held to
// 3000 to 3700 mV.
pub fn sysmin_code(mv: Int) -> Int
    step_code(mv, 3000, 100, 7)

// The absolute input voltage limit in millivolts for VINDPM, 0 to 127: 2600
// mV and 100 mV a step.  The part clamps a code below 13, 3900 mV, to it.
pub fn vindpm_mv(code: Int) -> Int
    2600 + (code & 0x7F) * 100

// The VINDPM code for a voltage in millivolts, rounded down and held to
// 3900 to 15300 mV, the part's range.
pub fn vindpm_code(mv: Int) -> Int
    if mv < 3900
        return 13
    step_code(mv, 2600, 100, 127)

// The boost voltage in millivolts for BOOSTV, 0 to 15: 4550 mV and 64 mV a
// step, to 5510 mV.
pub fn boostv_mv(code: Int) -> Int
    4550 + (code & 0x0F) * 64

// The BOOSTV code for a voltage in millivolts, rounded down and held to
// 4550 to 5510 mV.
pub fn boostv_code(mv: Int) -> Int
    step_code(mv, 4550, 64, 15)

// The battery voltage in millivolts for REG0E's BATV: 2304 mV and 20 mV a
// step.
//
// ```novo
// use bq25895
//
// fn main() [io]
//     println("${bq25895.vbat_mv_of(0x66)}")   // 4344
// ```
pub fn vbat_mv_of(code: Int) -> Int
    2304 + (code & 0x7F) * 20

// The system voltage in millivolts for REG0F's SYSV: 2304 mV and 20 mV a
// step.
pub fn vsys_mv_of(code: Int) -> Int
    2304 + (code & 0x7F) * 20

// The VBUS voltage in millivolts for REG11's VBUSV: 2600 mV and 100 mV a
// step.
pub fn vbus_mv_of(code: Int) -> Int
    2600 + (code & 0x7F) * 100

// The thermistor voltage as thousandths of a percent of REGN for REG10's
// TSPCT: 21 % and 0.465 % a step.
pub fn ts_milli_pct_of(code: Int) -> Int
    21000 + (code & 0x7F) * 465

// The charge current in milliamps for REG12's ICHGR: 50 mA a step.
pub fn ichgr_ma_of(code: Int) -> Int
    (code & 0x7F) * 50

// ── Identity ─────────────────────────────────────────────────────────

// REG14 as a `DeviceId`: `who` is the part number field PN, 7 for the
// BQ25895, and `rev` the device revision, 1.  `None` when the part does not
// answer or the part number is another.
pub fn id_read<P: Bq25895Port>(p: P) -> ?DeviceId [hw]
    let Some(r) = reg_read(p, REG14) else return None
    let pn = (r >> 3) & 7
    if pn != PN_BQ25895
        return None
    Some(DeviceId { who: pn, rev: Some(r & 3) })

// Resets every register to its default with REG_RST and waits for the bit
// to clear, which the part does when the reset is done: whether it did.
// The safety timer is reset with them.
pub fn reset<P: Bq25895Port>(p: P) -> Bool [hw]
    if not p.write_reg(REG14, REG_RST)
        return false
    for _i in 0..RESET_POLLS
        let Some(r) = reg_read(p, REG14) else return false
        if (r & REG_RST) == 0
            return true
    false

// Brings the part up: the bus made ready, the part number checked, and the
// watchdog disabled (see the head of the file).  The charge settings are
// the part's own until the program changes them.  Answers whether the part
// answered as a BQ25895 and took the watchdog setting.
pub fn start<P: Bq25895Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if id_read(p) == None
        return false
    watchdog_set(p, 0)

// ── The input ────────────────────────────────────────────────────────

// Sets the input current limit, rounded down to a step of 50 mA between 100
// and 3250 mA, and answers the milliamps set, or -1 when the part did not
// take it.  The limit changes after input detection (see the head of the
// file); the one in effect is `input_current_effective`.
pub fn input_current_set<P: Bq25895Port>(p: P, ma: Int) -> Int [hw]
    let c = ilim_code(ma)
    if reg_update(p, REG00, IINLIM_MASK, c)
        return ilim_ma(c)
    -1

// The IINLIM register's limit in milliamps, or -1.
pub fn input_current_get<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG00) else return -1
    ilim_ma(r & IINLIM_MASK)

// The input current limit in effect, REG13's IDPM_LIM, in milliamps, or -1:
// it follows the input source detection and the input current optimizer.
pub fn input_current_effective<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG13) else return -1
    ilim_ma(r & 0x3F)

// Turns the high-impedance mode on or off: the input is disconnected from
// the system (EN_HIZ).  Whether the part took it.
pub fn hiz_set<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = EN_HIZ
    reg_update(p, REG00, EN_HIZ, fl)

// Turns the ILIM pin's limit on or off (EN_ILIM): with it on the input
// current limit is the lower of the register and the pin.  Whether the part
// took it.
pub fn ilim_pin_set<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = EN_ILIM
    reg_update(p, REG00, EN_ILIM, fl)

// Sets the absolute input voltage limit VINDPM, rounded down and held to
// 3900 to 15300 mV, and answers the millivolts set, or -1.  Sets
// FORCE_VINDPM, which makes the register the limit and not the relative
// threshold.
pub fn vindpm_set<P: Bq25895Port>(p: P, mv: Int) -> Int [hw]
    let c = vindpm_code(mv)
    if reg_update(p, REG0D, FORCE_VINDPM | VINDPM_MASK, FORCE_VINDPM | c)
        return vindpm_mv(c)
    -1

// Turns the input current optimizer on or off (ICO_EN, on at reset).
// Whether the part took it.
pub fn ico_set<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = ICO_EN
    update_clearing(p, REG02, ICO_EN, fl, CONV_START)

// Whether the input current optimizer has found the maximum input current
// (ICO_OPTIMIZED), or `None`.
pub fn ico_optimized<P: Bq25895Port>(p: P) -> ?Bool [hw]
    let Some(r) = reg_read(p, REG14) else return None
    Some((r & 0x40) != 0)

// Sets what the part does when VBUS is plugged in: `auto` the D+/D-
// detection, `hvdcp` the HVDCP handshake and `maxcharge` the MaxCharge
// handshake (REG02's AUTO_DPDM_EN, HVDCP_EN and MAXC_EN, all on at reset).
// Whether the part took it.
pub fn detection_set<P: Bq25895Port>(p: P, auto: Bool, hvdcp: Bool, maxcharge: Bool) -> Bool [hw]
    var fl = 0
    if auto
        fl = fl | AUTO_DPDM_EN
    if hvdcp
        fl = fl | HVDCP_EN
    if maxcharge
        fl = fl | MAXC_EN
    update_clearing(p, REG02, AUTO_DPDM_EN | HVDCP_EN | MAXC_EN, fl, CONV_START)

// ── The charge ───────────────────────────────────────────────────────

// Turns the charge on or off (CHG_CONFIG; the CE pin must also be low).
// Whether the part took it.  REG03's WD_RST is written as 0.
pub fn charge_enable<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = CHG_CONFIG
    update_clearing(p, REG03, CHG_CONFIG, fl, WD_RST)

// Sets the fast charge current in milliamps, rounded down to a step of 64
// mA and held to 0 to 5056 mA, and answers the milliamps set, or -1.  0
// disables the charge.  EN_PUMPX, in the same register, is left alone.
pub fn charge_current_set<P: Bq25895Port>(p: P, ma: Int) -> Int [hw]
    let c = ichg_code(ma)
    if reg_update(p, REG04, ICHG_MASK, c)
        return ichg_ma(c)
    -1

// The fast charge current in milliamps, or -1.
pub fn charge_current_get<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG04) else return -1
    ichg_ma(r & ICHG_MASK)

// Sets the precharge current in milliamps, rounded down to a step of 64 mA
// between 64 and 1024 mA, and answers the milliamps set, or -1.
pub fn precharge_current_set<P: Bq25895Port>(p: P, ma: Int) -> Int [hw]
    let c = ipre_code(ma)
    if reg_update(p, REG05, IPRECHG_MASK, c << 4)
        return ipre_ma(c)
    -1

// The precharge current in milliamps, or -1.
pub fn precharge_current_get<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG05) else return -1
    ipre_ma((r >> 4) & 0x0F)

// Sets the termination current in milliamps, rounded down to a step of 64
// mA between 64 and 1024 mA, and answers the milliamps set, or -1.
pub fn termination_current_set<P: Bq25895Port>(p: P, ma: Int) -> Int [hw]
    let c = iterm_code(ma)
    if reg_update(p, REG05, ITERM_MASK, c)
        return iterm_ma(c)
    -1

// The termination current in milliamps, or -1.
pub fn termination_current_get<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG05) else return -1
    iterm_ma(r & ITERM_MASK)

// Turns the charge termination on or off (EN_TERM, on at reset).  Whether
// the part took it.
pub fn termination_enable<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = EN_TERM
    reg_update(p, REG07, EN_TERM, fl)

// Sets the charge voltage in millivolts, rounded down to a step of 16 mV
// and held to 3840 to 4608 mV, and answers the millivolts set, or -1.  The
// recharge threshold and the precharge-to-fast-charge threshold in the same
// register are left alone.
pub fn charge_voltage_set<P: Bq25895Port>(p: P, mv: Int) -> Int [hw]
    let c = vreg_code(mv)
    if reg_update(p, REG06, VREG_MASK, c << 2)
        return vreg_mv(c)
    -1

// The charge voltage in millivolts, or -1.
pub fn charge_voltage_get<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG06) else return -1
    vreg_mv((r >> 2) & 0x3F)

// Sets the recharge threshold: the battery voltage below the charge voltage
// at which a new charge starts, 100 or 200 mV (VRECHG).  Any `mv` under 150
// is 100.  Whether the part took it.
pub fn recharge_threshold_set<P: Bq25895Port>(p: P, mv: Int) -> Bool [hw]
    var fl = 0
    if mv >= 150
        fl = VRECHG
    reg_update(p, REG06, VRECHG, fl)

// Sets the battery voltage at which the precharge ends, 2800 or 3000 mV
// (BATLOWV, 3000 at reset).  Any `mv` under 2900 is 2800.  Whether the part
// took it.
pub fn precharge_threshold_set<P: Bq25895Port>(p: P, mv: Int) -> Bool [hw]
    var fl = 0
    if mv >= 2900
        fl = BATLOWV
    reg_update(p, REG06, BATLOWV, fl)

// Sets the minimum system voltage in millivolts, rounded down to a step of
// 100 mV and held to 3000 to 3700 mV, and answers the millivolts set, or -1.
// REG03's WD_RST is written as 0.
pub fn sysmin_set<P: Bq25895Port>(p: P, mv: Int) -> Int [hw]
    let c = sysmin_code(mv)
    if update_clearing(p, REG03, SYS_MIN_MASK, c << 1, WD_RST)
        return sysmin_mv(c)
    -1

// Sets the fast-charge safety timer: `hours` 5, 8, 12 or 20 enables it with
// that limit, and 0 disables it (EN_TIMER).  Any other `hours` is refused.
// Whether the part took it.
pub fn safety_timer_set<P: Bq25895Port>(p: P, hours: Int) -> Bool [hw]
    if hours == 0
        return reg_update(p, REG07, EN_TIMER, 0)
    var code = -1
    if hours == 5
        code = 0
    if hours == 8
        code = 1
    if hours == 12
        code = 2
    if hours == 20
        code = 3
    if code < 0
        return false
    reg_update(p, REG07, EN_TIMER | CHG_TIMER_MASK, EN_TIMER | (code << 1))

// ── The watchdog ─────────────────────────────────────────────────────

// Sets the I2C watchdog: `secs` 0 disables it, 40, 80 or 160 enables it
// with that period (WATCHDOG, 40 s at reset).  Any other `secs` is
// refused.  Whether the part took it.
pub fn watchdog_set<P: Bq25895Port>(p: P, secs: Int) -> Bool [hw]
    var code = -1
    if secs == 0
        code = 0
    if secs == 40
        code = 1
    if secs == 80
        code = 2
    if secs == 160
        code = 3
    if code < 0
        return false
    reg_update(p, REG07, WATCHDOG_MASK, code << 4)

// Resets the watchdog timer by writing 1 to WD_RST, which the part clears
// itself: whether the part acknowledged.  The other bits of REG03 are
// written as they read, so the charge and the boost mode are not changed.
pub fn watchdog_feed<P: Bq25895Port>(p: P) -> Bool [hw]
    let Some(old) = reg_read(p, REG03) else return false
    p.write_reg(REG03, old | WD_RST)

// ── Status and faults ────────────────────────────────────────────────

// REG0B, the status byte, or -1 when the part did not answer.
pub fn status_read<P: Bq25895Port>(p: P) -> Int [hw]
    reg_read(p, REG0B) ?? -1

// The VBUS status of a REG0B byte: 0 no input, 1 USB host SDP, 2 USB CDP, 3
// USB DCP, 4 adjustable high voltage DCP (MaxCharge), 5 unknown adapter, 6
// non-standard adapter, 7 OTG (the part supplies VBUS).
pub fn vbus_status(status: Int) -> Int
    (status >> 5) & 7

// The charging status of a REG0B byte: 0 not charging, 1 precharge, 2 fast
// charging, 3 charge termination done.
pub fn chrg_status(status: Int) -> Int
    (status >> 3) & 3

// Whether a REG0B byte reports power good (PG_STAT).
pub fn power_good(status: Int) -> Bool
    ((status >> 2) & 1) == 1

// Reads REG0C twice, alone, and answers both reads: the first is the
// faults since the last read and the second the present state.  `None` when
// the part did not answer.  Fix kept: the register keeps a fault until it is
// read and the part sends no INT for a new one until then, so a program that
// reads once sees an old fault, or none that has gone.
pub fn faults_read<P: Bq25895Port>(p: P) -> ?Bq25895Faults [hw]
    let Some(past) = reg_read(p, REG0C) else return None
    let Some(now) = reg_read(p, REG0C) else return None
    Some(Bq25895Faults { past: past, now: now })

// Whether a REG0C byte reports a watchdog expiry.
pub fn fault_watchdog(r: Int) -> Bool
    (r & 0x80) != 0

// Whether a REG0C byte reports a boost-mode fault: VBUS overloaded, VBUS
// over-voltage, or the battery too low.
pub fn fault_boost(r: Int) -> Bool
    (r & 0x40) != 0

// The charge fault of a REG0C byte: 0 normal, 1 input fault, 2 thermal
// shutdown, 3 charge safety timer expiration.
pub fn fault_charge(r: Int) -> Int
    (r >> 4) & 3

// Whether a REG0C byte reports a battery over-voltage.
pub fn fault_battery(r: Int) -> Bool
    (r & 0x08) != 0

// The NTC fault of a REG0C byte: in buck mode 0 normal, 1 TS cold, 2 TS hot;
// in boost mode 5 TS cold and 6 TS hot.
pub fn fault_ntc(r: Int) -> Int
    r & 7

// The phase `PowerManager` names for a charging status and a fault: a
// fault is `ChargeFault`; 0 is `ChargeIdle`, 1 `ChargePrecharge`, 2
// `ChargeActive` (the part's fast charge is the constant current and the
// constant voltage phases, and its registers do not tell them apart) and 3
// `ChargeDone`.
pub fn charge_state_of(chrg: Int, faulted: Bool) -> ChargeState
    if faulted
        return ChargeState.ChargeFault
    if chrg == 1
        return ChargeState.ChargePrecharge
    if chrg == 2
        return ChargeState.ChargeActive
    if chrg == 3
        return ChargeState.ChargeDone
    ChargeState.ChargeIdle

// Whether a REG0C byte is a fault that stops the charge: a watchdog
// expiry, a charge fault, a battery over-voltage or an NTC fault in buck
// mode.
fn faulted(r: Int) -> Bool
    fault_watchdog(r) or fault_charge(r) != 0 or fault_battery(r) or fault_ntc(r) != 0

// The charge phase now, from REG0B and the present state of REG0C: a
// fault is `ChargeFault`.  `ChargeIdle` when the part does not answer.
pub fn charge_state<P: Bq25895Port>(p: P) -> ChargeState [hw]
    let s = status_read(p)
    if s < 0
        return ChargeState.ChargeIdle
    let Some(f) = faults_read(p) else return ChargeState.ChargeIdle
    charge_state_of(chrg_status(s), faulted(f.now))

// Where the system draws its power from, `PowerSource`: a source on VBUS
// (VBUS_STAT 1 to 6) is `PowerUsb`; no input, and OTG mode, in which the part
// supplies VBUS from the cell, are `PowerBattery`; `PowerUnknown` when the
// part does not answer.
pub fn source_read<P: Bq25895Port>(p: P) -> PowerSource [hw]
    let s = status_read(p)
    if s < 0
        return PowerSource.PowerUnknown
    let v = vbus_status(s)
    if v == 0 or v == 7
        return PowerSource.PowerBattery
    PowerSource.PowerUsb

// ── The battery monitor ──────────────────────────────────────────────

// Starts a one-shot conversion (CONV_START with CONV_RATE clear): whether
// the part took it.  The part clears CONV_START when the conversion is done.
pub fn adc_start<P: Bq25895Port>(p: P) -> Bool [hw]
    let Some(r) = reg_read(p, REG02) else return false
    if (r & CONV_RATE) != 0
        return false
    p.write_reg(REG02, r | CONV_START)

// Whether a conversion is running: CONV_START is set, which it also is
// during input source detection.  `None` when the part did not answer.
pub fn adc_busy<P: Bq25895Port>(p: P) -> ?Bool [hw]
    let Some(r) = reg_read(p, REG02) else return None
    Some((r & CONV_START) != 0)

// Turns the continuous conversion, once a second, on or off (CONV_RATE).
// With it on CONV_START is read-only.  Whether the part took it.
pub fn adc_continuous<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = CONV_RATE
    update_clearing(p, REG02, CONV_RATE, fl, CONV_START)

// The five readings of the battery monitor, REG0E to REG12 in one
// transaction, or `None` when the part did not answer.  Whether they are
// fresh is the caller's: see `adc_measure`.
pub fn adc_read<P: Bq25895Port>(p: P) -> ?Bq25895Adc [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG0E, 5, var b)
        return None
    Some(Bq25895Adc { vbat_mv: vbat_mv_of(b[0] as Int),
        vsys_mv: vsys_mv_of(b[1] as Int),
        vbus_mv: vbus_mv_of(b[3] as Int),
        ts_milli_pct: ts_milli_pct_of(b[2] as Int),
        ichg_ma: ichgr_ma_of(b[4] as Int),
        vbus_good: (b[3] as Int & 0x80) != 0 })

// One conversion on request, waited for: starts it, pauses 10 ms at a time
// up to `polls` times until CONV_START clears, then reads the five
// readings.  `None` when the part did not answer or the conversion did not
// finish.  With the continuous conversion on, the latest readings.  The
// data sheet's maximum conversion time is 1 s, so `polls` of 100 or more
// waits for it.
pub fn adc_measure<P: Bq25895Port>(p: P, polls: Int) -> ?Bq25895Adc [hw]
    let Some(r) = reg_read(p, REG02) else return None
    if (r & CONV_RATE) != 0
        return adc_read(p)
    if not adc_start(p)
        return None
    for _i in 0..polls
        let Some(busy) = adc_busy(p) else return None
        if not busy
            return adc_read(p)
        p.pause_ms(ADC_POLL_MS)
    None

// ── The boost mode ───────────────────────────────────────────────────

// Sets the boost output (OTG): the voltage in millivolts, rounded down to a
// step of 64 mV and held to 4550 to 5510 mV, and the switching frequency,
// 500 or 1500 kHz.  Answers the millivolts set, or -1.  Fix kept: the
// frequency is written first, since "write to this bit is ignored when
// OTG_CONFIG is enabled" (REG02), and the part must not be enabled by
// this call.
pub fn boost_set<P: Bq25895Port>(p: P, mv: Int, khz: Int) -> Int [hw]
    var fl = 0
    if khz < 1000
        fl = BOOST_FREQ
    if not update_clearing(p, REG02, BOOST_FREQ, fl, CONV_START)
        return -1
    let c = boostv_code(mv)
    if reg_update(p, REG0A, BOOSTV_MASK, c << 4)
        return boostv_mv(c)
    -1

// The boost output voltage in millivolts, or -1.
pub fn boost_voltage_get<P: Bq25895Port>(p: P) -> Int [hw]
    let Some(r) = reg_read(p, REG0A) else return -1
    boostv_mv((r >> 4) & 0x0F)

// Turns the boost mode on or off (OTG_CONFIG).  The mode starts when the
// OTG pin is high and no input source is detected.  Whether the part took
// it.  REG03's WD_RST is written as 0.
pub fn boost_enable<P: Bq25895Port>(p: P, on: Bool) -> Bool [hw]
    var fl = 0
    if on
        fl = OTG_CONFIG
    update_clearing(p, REG03, OTG_CONFIG, fl, WD_RST)

// ── The battery ship mode ────────────────────────────────────────────

// Forces the battery FET off (BATFET_DIS), which puts the system in ship
// mode and removes its power: immediately, or after the 10 to 15 s delay
// (`delay`, BATFET_DLY).  Exit is by plugging an input, a low on the QON pin
// or clearing BATFET_DIS.  Whether the part took it.
pub fn ship_mode<P: Bq25895Port>(p: P, delay: Bool) -> Bool [hw]
    var fl = BATFET_DIS
    if delay
        fl = fl | BATFET_DLY
    update_clearing(p, REG09, BATFET_DIS | BATFET_DLY, fl, 0x80)

// ── The power manager ────────────────────────────────────────────────

// The measurement `PowerManager.battery` answers: one conversion on
// request (`adc_measure`, 1 s at most) and then the battery voltage, the
// charge current (positive; the part does not measure a discharge), the
// phase and no percent, since a charger has no gauge.  `None` when the part
// did not answer or the conversion did not finish.
pub fn battery_read<P: Bq25895Port>(p: P) -> ?BatteryReading [hw]
    let Some(a) = adc_measure(p, ADC_POLLS) else return None
    Some(BatteryReading { voltage: MilliVolts { mv: a.vbat_mv },
        current: MilliAmps { ma: a.ichg_ma },
        charge: charge_state(p),
        percent: None })

// The state of the boost rail, rail 0: on when OTG_CONFIG is set and the
// VBUS status is OTG, faulted when the boost fault bit is set, off otherwise.
pub fn rail_state_of<P: Bq25895Port>(p: P, rail: Int) -> RailState [hw]
    if rail != 0
        return RailState.RailOff
    let Some(f) = faults_read(p) else return RailState.RailOff
    if fault_boost(f.now)
        return RailState.RailFault
    let s = status_read(p)
    let c = reg_read(p, REG03) ?? 0
    if s >= 0 and vbus_status(s) == 7 and (c & OTG_CONFIG) != 0
        return RailState.RailOn
    RailState.RailOff

// The boost rail's set voltage, or `None` for another rail.
pub fn rail_voltage_of<P: Bq25895Port>(p: P, rail: Int) -> ?MilliVolts [hw]
    if rail != 0
        return None
    let v = boost_voltage_get(p)
    if v < 0
        return None
    Some(MilliVolts { mv: v })

// Sets the boost rail to the highest step at or below the request and
// answers the voltage set; `None` for another rail, a request below 4550 mV
// and a refused write.  The frequency is not changed.
pub fn rail_set_voltage_of<P: Bq25895Port>(p: P, rail: Int, v: MilliVolts) -> ?MilliVolts [hw]
    if rail != 0
        return None
    let Some(step) = dev_power.power_step(v, 4550, 5510, 64) else return None
    let c = boostv_code(step.mv)
    if reg_update(p, REG0A, BOOSTV_MASK, c << 4)
        return Some(step)
    None

// The battery's condition from REG0C's present state: a battery
// over-voltage (BAT_FAULT) is `HealthOvervoltage`, an NTC fault of a cold
// thermistor is `HealthCold` and of a hot one `HealthOverheat` (1 and 2 in
// buck mode, 5 and 6 in boost mode), any other NTC code is `HealthFault`,
// and a register without those faults is `HealthGood`.  `HealthUnknown`
// when the part does not answer.  The part has no flag for a dead cell, so
// `HealthDead` is never answered.
pub fn battery_health_of<P: Bq25895Port>(p: P) -> BatteryHealth [hw]
    let Some(f) = faults_read(p) else return BatteryHealth.HealthUnknown
    if fault_battery(f.now)
        return BatteryHealth.HealthOvervoltage
    let ntc = fault_ntc(f.now)
    if ntc == 1 or ntc == 5
        return BatteryHealth.HealthCold
    if ntc == 2 or ntc == 6
        return BatteryHealth.HealthOverheat
    if ntc != 0
        return BatteryHealth.HealthFault
    BatteryHealth.HealthGood

// The fast charge current, `PowerManager.charge_current`: the constant
// current of the main phase, or `None` when the part did not answer.
pub fn charge_current_of<P: Bq25895Port>(p: P) -> ?MilliAmps [hw]
    let ma = charge_current_get(p)
    if ma < 0
        return None
    Some(MilliAmps { ma: ma })

// Sets the fast charge current to the step of 64 mA at or below the
// request, `PowerManager.charge_set_current`, and answers the current set.
// `None` for a negative request and for a refused write.
pub fn charge_set_current_of<P: Bq25895Port>(p: P, i: MilliAmps) -> ?MilliAmps [hw]
    if i.ma < 0
        return None
    let ma = charge_current_set(p, i.ma)
    if ma < 0
        return None
    Some(MilliAmps { ma: ma })

// The charge voltage, `PowerManager.charge_voltage_limit`, or `None` when
// the part did not answer.
pub fn charge_voltage_limit_of<P: Bq25895Port>(p: P) -> ?MilliVolts [hw]
    let mv = charge_voltage_get(p)
    if mv < 0
        return None
    Some(MilliVolts { mv: mv })

// Sets the charge voltage to the step of 16 mV at or below the request,
// `PowerManager.charge_set_voltage_limit`, and answers the voltage set.  A
// request above 4608 mV sets 4608 mV, the part's top.  `None` for a request
// below 3840 mV, which `charge_voltage_set` would raise to 3840 mV, and for
// a refused write; the voltage is never set above the request.
pub fn charge_set_voltage_limit_of<P: Bq25895Port>(p: P, v: MilliVolts) -> ?MilliVolts [hw]
    if v.mv < 3840
        return None
    let mv = charge_voltage_set(p, v.mv)
    if mv < 0
        return None
    Some(MilliVolts { mv: mv })

// The input current limit register, `PowerManager.input_current_limit`, or
// `None` when the part did not answer.  The limit in effect, which follows
// input source detection, is `input_current_effective`.
pub fn input_current_limit_of<P: Bq25895Port>(p: P) -> ?MilliAmps [hw]
    let ma = input_current_get(p)
    if ma < 0
        return None
    Some(MilliAmps { ma: ma })

// Sets the input current limit to the step of 50 mA at or below the
// request, `PowerManager.input_set_current_limit`, and answers the limit
// set.  `None` for a request below 100 mA, which `input_current_set` would
// raise to 100 mA, and for a refused write; a request above 3250 mA sets
// 3250 mA.
pub fn input_set_current_limit_of<P: Bq25895Port>(p: P, i: MilliAmps) -> ?MilliAmps [hw]
    if i.ma < 100
        return None
    let ma = input_current_set(p, i.ma)
    if ma < 0
        return None
    Some(MilliAmps { ma: ma })

// ── The awaitable INT line ───────────────────────────────────────────

// Stays a package function (planning page 3.5, the AsyncDeviceReady row):
// no board's `BoardGpio` implements `AsyncEdge`, so a board driver cannot
// implement `AsyncDeviceReady`.
// Arms the INT pin on a pin-edge source: the Future `f` resolves with the
// level captured when the line falls, which is the start of the part's
// 256 us pulse for a source identified, a good input, an input removed, a
// charge complete or a fault (section 8.2.9.2).  `edge` is any
// implementation of embedded-hal-nv's `AsyncEdge`; no board's GPIO
// implements it today.  The caller makes `f` with `core.rt.future_new` and
// awaits it with `core.rt.future_await`, then reads `faults_read` and
// `status_read`.  Answers 0 when armed, and -1 when the wiring has no
// interrupt pin or the source refused.
pub fn int_arm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring, f: Future) -> Int [e]
    let Some(irq) = w.irq else return -1
    edge.edge_arm(irq, 1, f)

// Takes the arm back: whether it was still armed.  See `AsyncEdge`.
pub fn int_disarm<E: AsyncEdge[e]>(edge: E, w: DeviceWiring) -> Bool [e]
    let Some(irq) = w.irq else return false
    edge.edge_disarm(irq)

// ── The part on a board ──────────────────────────────────────────────

// A BQ25895 on a board's I2C bus at the address `w.addr`, 0x6A, with the
// bus for the waits (`I2cBus.delay_ms`) and the board's GPIO for the INT
// line.
pub @value
struct Bq25895
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Bq25895Port for Bq25895
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn pause_ms(self, ms: Int) [hw]
        self.bus.delay_ms(ms)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

impl Bq25895
    // The part at `w.addr` on the board's bus, as a board's device table
    // builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Bq25895
        Bq25895 { bus: bus, pins: pins, w: w }

    // Makes the bus ready, checks the part number and disables the
    // watchdog (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // Resets every register to its default.
    fn reset_all(self) -> Bool [hw]
        reset(self)

    // Turns the charge on or off.
    fn set_charging(self, on: Bool) -> Bool [hw]
        charge_enable(self, on)

    // Sets the precharge and the termination current in milliamps.
    fn set_precharge_current(self, ma: Int) -> Int [hw]
        precharge_current_set(self, ma)

    fn set_termination_current(self, ma: Int) -> Int [hw]
        termination_current_set(self, ma)

    // The input current limit in effect, which follows input source
    // detection; `PowerManager.input_current_limit` is the register.
    fn input_current(self) -> Int [hw]
        input_current_effective(self)

    // Resets the watchdog.
    fn feed_watchdog(self) -> Bool [hw]
        watchdog_feed(self)

    // The faults since the last read and the present ones.
    fn faults(self) -> ?Bq25895Faults [hw]
        faults_read(self)

    // The charge phase now.
    fn charge(self) -> ChargeState [hw]
        charge_state(self)

    // The five readings of the battery monitor after one conversion.
    fn measure(self) -> ?Bq25895Adc [hw]
        adc_measure(self, ADC_POLLS)

    // The boost output: sets its voltage and frequency, and turns it on or
    // off.
    fn set_boost(self, mv: Int, khz: Int) -> Int [hw]
        boost_set(self, mv, khz)

    fn enable_boost(self, on: Bool) -> Bool [hw]
        boost_enable(self, on)

    // The level of the INT line, -1 for a wiring with none.
    fn int_level(self) -> Int [hw]
        self.irq_level()

impl PowerManager[hw] for Bq25895
    // The one rail is the boost output, rail 0.
    fn rail_count(self) -> Int [hw]
        1

    fn rail_state(self, rail: Int) -> RailState [hw]
        rail_state_of(self, rail)

    fn rail_voltage(self, rail: Int) -> ?MilliVolts [hw]
        rail_voltage_of(self, rail)

    // Sets the boost rail to the highest step at or below the request.
    fn rail_set_voltage(self, rail: Int, v: MilliVolts) -> ?MilliVolts [hw]
        rail_set_voltage_of(self, rail, v)

    // Turns the boost mode on or off; the part has no other rail.
    fn rail_enable(self, rail: Int, on: Bool) -> Bool [hw]
        if rail != 0
            return false
        boost_enable(self, on)

    // The battery voltage and the charge current after one conversion, the
    // phase, and no percent.
    fn battery(self) -> ?BatteryReading [hw]
        battery_read(self)

    fn power_source(self) -> PowerSource [hw]
        source_read(self)

    fn charge_current(self) -> ?MilliAmps [hw]
        charge_current_of(self)

    fn charge_set_current(self, i: MilliAmps) -> ?MilliAmps [hw]
        charge_set_current_of(self, i)

    fn charge_voltage_limit(self) -> ?MilliVolts [hw]
        charge_voltage_limit_of(self)

    fn charge_set_voltage_limit(self, v: MilliVolts) -> ?MilliVolts [hw]
        charge_set_voltage_limit_of(self, v)

    fn input_current_limit(self) -> ?MilliAmps [hw]
        input_current_limit_of(self)

    fn input_set_current_limit(self, i: MilliAmps) -> ?MilliAmps [hw]
        input_set_current_limit_of(self, i)

    // From the fault register: over-voltage, cold and hot thermistor.
    fn battery_health(self) -> BatteryHealth [hw]
        battery_health_of(self)

// battery_capacity and battery_temperature keep the trait's bodies: a
// charger has no gauge, and its thermistor is read as a percent of REGN,
// not as a temperature.

impl Identifiable[hw] for Bq25895
    // The part number field of REG14, 7, with the device revision as `rev`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

// ── The host scheduler's async form ──────────────────────────────────

// Stays as it is (planning page 3.5, the `*Async` row): an `async fn` takes
// no `@value` struct and the embedded tier refuses it, so this is a plain
// struct with an `@tier(app)` impl.
//
// A part on the host scheduler, which implements `PowerManagerAsync`:
// `battery_measure` starts a conversion, parks the task 10 ms at a time
// until the part clears CONV_START (at most 120 times), and answers the
// battery.  `dev` is any `Bq25895Port`.  The struct is not a `@value`
// struct, since an `async fn` takes none (SPEC § 14.5) and a struct with a
// generic field cannot be one; `host_of` builds it as one cell of the
// arena.  The impl is `@tier(app)`: the embedded tier refuses an `async fn`
// (E4002).  On a device the awaitable form is `int_arm`.
pub struct Bq25895Host<P: Bq25895Port>
    dev: P

// The host-scheduler form of the part `dev`.
pub @tier(app)
fn host_of<P: Bq25895Port>(dev: P) -> Bq25895Host<P>
    Bq25895Host { dev: dev }

impl PowerManagerAsync[hw, time] for Bq25895Host
    @tier(app)
    async fn battery_measure(self) -> ?BatteryReading [hw, time]
        let Some(r) = reg_read(self.dev, REG02) else return None
        if (r & CONV_RATE) == 0
            if not adc_start(self.dev)
                return None
            for _i in 0..ADC_POLLS
                let Some(busy) = adc_busy(self.dev) else return None
                if not busy
                    break
                core.rt.sleep_ms(ADC_POLL_MS)
        let Some(a) = adc_read(self.dev) else return None
        Some(BatteryReading { voltage: MilliVolts { mv: a.vbat_mv },
            current: MilliAmps { ma: a.ichg_ma },
            charge: charge_state(self.dev),
            percent: None })
